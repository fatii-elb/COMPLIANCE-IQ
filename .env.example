# ---------------------------------------------------------------------------
# ComplianceIQ AI Service — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; NEVER commit real secrets.
# Every value here is read via pydantic-settings (see
# src/complianceiq/infrastructure/config/settings.py). Twelve-factor: all
# configuration comes from the environment, never from source.
# ---------------------------------------------------------------------------

# --- Core service identity ---
CIQ_APP_NAME=complianceiq-ai
CIQ_ENVIRONMENT=local            # local | dev | staging | production
CIQ_DEBUG=false
CIQ_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
CIQ_LOG_JSON=true                # false = human-readable console logs for local dev

# --- HTTP server ---
CIQ_HOST=0.0.0.0
CIQ_PORT=8000
CIQ_REQUEST_MAX_BYTES=1048576    # 1 MiB request-size limit

# --- Security / auth (JWT is issued by the Core Service; we only verify) ---
# The Core Service signs tenant JWTs. In production this is an asymmetric key
# or a JWKS URL. Left empty here; auth wiring lands in Phase 6.
CIQ_JWT_AUDIENCE=complianceiq
CIQ_JWT_ISSUER=complianceiq-core
CIQ_JWT_PUBLIC_KEY=

# --- Database (PostgreSQL + pgvector) — wired in Phase 6 ---
CIQ_DATABASE_URL=postgresql+asyncpg://complianceiq:complianceiq@postgres:5432/complianceiq

# --- LLM providers (Phase 2). Leave keys blank to use the deterministic fake. ---
CIQ_LLM_PRIMARY_PROVIDER=fake    # fake | anthropic | openai_compatible

# Anthropic (Claude) — primary provider when selected.
CIQ_ANTHROPIC_API_KEY=
CIQ_ANTHROPIC_MODEL_REASONING=claude-3-5-sonnet-latest
CIQ_ANTHROPIC_MODEL_FAST=claude-3-5-haiku-latest

# OpenAI-compatible — secondary provider / fallback / embeddings.
CIQ_OPENAI_BASE_URL=
CIQ_OPENAI_API_KEY=
CIQ_OPENAI_CHAT_MODEL=gpt-4o-mini
CIQ_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CIQ_OPENAI_EMBEDDING_DIMENSIONS=1536

# --- AI gateway policies (Phase 2) ---
CIQ_GATEWAY_REQUEST_TIMEOUT_SECONDS=30
CIQ_GATEWAY_MAX_RETRIES=2
CIQ_GATEWAY_RETRY_BASE_DELAY_SECONDS=0.5
CIQ_GATEWAY_RETRY_MAX_DELAY_SECONDS=8
CIQ_GATEWAY_RATE_LIMIT_PER_MINUTE=60
CIQ_GATEWAY_TENANT_BUDGET_USD=50
CIQ_GATEWAY_CACHE_TTL_SECONDS=3600

# --- Knowledge base & retrieval (Phase 3) ---
CIQ_KNOWLEDGE_CORPUS_DIR=corpus/frameworks
CIQ_KNOWLEDGE_CORPUS_VERSION=v1
CIQ_KNOWLEDGE_AUTOLOAD=true       # ingest the bundled corpus at startup
CIQ_RETRIEVAL_CANDIDATE_MULTIPLIER=4
CIQ_RETRIEVAL_RERANK_TOP_K=20
CIQ_RETRIEVAL_RRF_K=60
CIQ_RETRIEVAL_MMR_LAMBDA=0.5
CIQ_RETRIEVAL_CONTEXT_TOKEN_BUDGET=2000
CIQ_RETRIEVAL_CHUNK_MAX_TOKENS=400

# --- Core Service client — wired in Phase 6. Points at the stub locally. ---
CIQ_CORE_API_BASE_URL=http://core-stub:9000
